{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/inject_gate.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/manual_sync.py",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/check_output.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/guard_delivery.py"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/auto_update.py"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ${CLAUDE_PROJECT_DIR}/.claude/hooks/handover_receipt.py"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Artifact",
      "SendUserFile",
      "mcp__claude-artifacts__publish_files",
      "mcp__claude-artifacts__publish_version",
      "mcp__claude-artifacts__edit_version",
      "mcp__claude-artifacts__create_from_type",
      "mcp__claude-artifacts__upload_asset",
      "mcp__claude-artifacts__get_artifact",
      "mcp__claude-artifacts__read_artifact",
      "mcp__claude-artifacts__list_artifacts",
      "mcp__claude-artifacts__list_files",
      "mcp__claude-artifacts__read_file",
      "mcp__claude-artifacts__list_types",
      "mcp__claude-artifacts__guide",
      "mcp__claude-artifacts__describe_capabilities",
      "mcp__Google_Drive__search_files",
      "mcp__Google_Drive__read_file_content",
      "mcp__Google_Drive__download_file_content",
      "mcp__Google_Drive__get_file_metadata",
      "mcp__Google_Drive__list_recent_files",
      "mcp__Google_Drive__get_file_permissions",
      "mcp__Google_Sheets__get_spreadsheet",
      "mcp__Google_Sheets__get_values",
      "mcp__Gmail__search_threads",
      "mcp__Gmail__get_message",
      "mcp__Gmail__get_thread",
      "mcp__Gmail__list_labels",
      "mcp__Google_Calendar__list_events",
      "mcp__Google_Calendar__search_events",
      "mcp__Google_Calendar__get_event",
      "mcp__Google_Calendar__list_calendars",
      "mcp__Claude_Code_Remote__list_sessions",
      "mcp__Claude_Code_Remote__get_session",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__get_trigger",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__read_documentation",
      "mcp__github__search_repositories",
      "mcp__github__get_file_contents",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__list_branches",
      "mcp__github__list_pull_requests",
      "mcp__github__pull_request_read",
      "mcp__github__list_issues",
      "mcp__github__issue_read",
      "mcp__github__search_code",
      "mcp__github__get_me",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__get_check_run"
    ]
  }
}
