__pycache__/
*.pyc
.env
metrics/compliance.jsonl
metrics/.stopguard-*
metrics/.terms-*
# 配布用の一括ZIP（生成物。git ls-files から毎回作り直せるため追跡しない）
manual_v*_all_*.zip
manual_v*_deliverables_*.zip

# 引き継ぎファイルは会話の原文を含むため、既定では追跡しない（L1 §10-5・§8-4）。
# 共有する必要があるときだけ、中身を確認したうえで `git add -f` する。
# **サブフォルダも含めて無視する。** `handover/*.md` は直下にしか効かず、
# v34 で導入した案件ごとのフォルダ（`handover/<案件名>/`）が対象から外れていた。
# その結果、会話の原文を含む引き継ぎが**公開リポジトリへ push された**（2026-09-03 の事故）。
handover/**/*.md
handover/*.md
!handover/README.md

# フックがセッションごとに置く目印（同じセッションで二度動かないようにするためのもの）。
# セッション固有の値であり、引き継げない＝追跡しない。
metrics/.handover-*
metrics/.stopguard-*
metrics/.terms-*

# 発行担当の印。**リポジトリに含めない。**
# 含めるとすべての複製が発行可能になり、「発行は1つのセッションだけ」という趣旨が壊れる。
.claude/manual-session
